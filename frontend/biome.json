{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": { "includes": ["**", "!.next", "!coverage", "!public", "!next-env.d.ts"] },
	"formatter": { "enabled": true, "indentStyle": "tab", "indentWidth": 2, "lineWidth": 110 },
	"javascript": {
		"formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
	},
	"css": { "parser": { "tailwindDirectives": true } },
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"domains": { "next": "recommended", "react": "recommended" },
		"rules": {
			"preset": "recommended",
			"style": { "noNonNullAssertion": "warn" },
			"suspicious": { "noExplicitAny": "error" },
			"correctness": { "noUnusedImports": "error", "noUnusedVariables": "warn" },
			"nursery": { "useSortedClasses": "warn" }
		}
	}
}
