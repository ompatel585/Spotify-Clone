{
	"name": "spotify-frontend",
	"version": "1.0.0",
	"private": true,
	"description": "Spotify clone web app: Next.js 16, RTK Query, Tailwind CSS v4",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "next dev --port 3000",
		"build": "next build",
		"start": "next start --port 3000",
		"typecheck": "next typegen && tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@hookform/resolvers": "^5.9.1",
		"@reduxjs/toolkit": "^2.13.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.50.0",
		"next": "^16.3.8",
		"radix-ui": "^1.6.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-hook-form": "^7.89.0",
		"react-redux": "^9.3.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@tailwindcss/postcss": "latest",
		"@types/node": "^24",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2"
	}
