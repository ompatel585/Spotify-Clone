{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": { "includes": ["**", "!dist", "!coverage"] },
	"formatter": { "enabled": true, "indentStyle": "tab", "indentWidth": 2, "lineWidth": 110 },
	"javascript": {
		"formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" },
		"parser": { "unsafeParameterDecoratorsEnabled": true }
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": { "useImportType": "off", "noNonNullAssertion": "warn" },
			"suspicious": { "noExplicitAny": "error" },
			"correctness": { "noUnusedImports": "error", "noUnusedVariables": "warn" }
		}
	}
}
