# App
NODE_ENV=development
PORT=5000
# Public origin of the web app (CORS, OAuth redirects, cookies)
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=loopback
LOG_LEVEL=debug

# Database. Local: mongodb://127.0.0.1:27017/spotify   Atlas: mongodb+srv://<user>:<pass>@<cluster>/spotify?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/spotify

# Auth. Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_SOCKET_SECRET=change-me-socket-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Users signing up with these emails become admins
ADMIN_EMAILS=admin@example.com

# Optional Google OAuth (empty = disabled). Redirect URI: <WEB_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (admin uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=spotify
