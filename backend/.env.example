# App
NODE_ENV=development
PORT=5000
# Public origin of the web app (CORS, OAuth redirects, cookies)
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=loopback
LOG_LEVEL=debug
# Abort requests that run longer than this (0 = off)
REQUEST_TIMEOUT_MS=30000

# Database. Local: mongodb://127.0.0.1:27017/spotify   Atlas: mongodb+srv://<user>:<pass>@<cluster>/spotify?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/spotify
# If mongodb+srv:// fails with "querySrv ECONNREFUSED" (Node cannot use the OS resolver), set e.g. DNS_SERVERS=8.8.8.8,1.1.1.1
# DNS_SERVERS=
DB_MAX_POOL_SIZE=20
DB_MIN_POOL_SIZE=0
DB_SERVER_SELECTION_TIMEOUT_MS=5000
DB_CONNECT_RETRIES=3
DB_CONNECT_RETRY_DELAY_MS=2000
# Build indexes on startup. Defaults to on in development, off in production (create them via migrations/seed there)
# DB_AUTO_INDEX=true

# Auth. Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_SOCKET_SECRET=change-me-socket-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Lifetime of the one-shot websocket handshake ticket
JWT_SOCKET_TICKET_TTL=60s
# Set when the API and web app live on sibling subdomains; leave empty otherwise
# COOKIE_DOMAIN=
# Defaults to true in production. Set false only for plain-http staging
# COOKIE_SECURE=true
# Users signing up with these emails become admins
ADMIN_EMAILS=admin@example.com

# Rate limiting: default tier for every route, stricter tier for @StrictThrottle() routes (login, register)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_STRICT_TTL_MS=60000
THROTTLE_STRICT_LIMIT=10

# Optional Google OAuth (empty = disabled). Redirect URI: <WEB_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (admin uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=spotify
