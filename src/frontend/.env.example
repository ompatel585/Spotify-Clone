# Where Next proxies /api/* and /socket.io/* (server-side only, never exposed to the browser)
API_ORIGIN=http://localhost:5000

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Socket.io connects to the API directly; leave empty to go through the Next proxy (same origin)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
