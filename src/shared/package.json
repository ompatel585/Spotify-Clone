{
	"name": "@spotify/shared",
	"version": "1.0.0",
	"private": true,
	"description": "Types, socket contracts and constants shared by the Spotify web app and API",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"typescript": "^7.0.2"
	}
}
